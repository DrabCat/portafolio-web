---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { projects } from '../data/projects';
---

<Layout title="Inicio" currentPath="/">
  <div class="space-y-24 md:space-y-32">
    <!-- Hero Minimalista con Animación de Entrada Suave -->
    <section class="py-12 md:py-20 max-w-4xl animate-fade-up">
      <h1 class="text-3xl sm:text-4xl md:text-4xl lg:text-5xl font-editorial-mono font-normal leading-[1.1] tracking-tight text-neutral-100">
        Diseño y desarrollo experiencias digitales que convierten ideas en sitios web funcionales, intuitivos y orientados a resultados.
      </h1>
      <h2 class="font-editorial-mono text-base sm:text-lg font-normal leading-relaxed tracking-normal text-neutral-300 mt-4">
          Soy Daniela, diseñadora web especializada en UX/UI, WordPress e implementación.
      </h2>
    </section>
    <!-- Galería de 4 Proyectos -->
    <section class="pb-12">
      <ProjectGrid projects={projects} />
    </section>
  </div>
</Layout>
