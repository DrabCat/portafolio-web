---
interface Props {
  caption?: string;
  class?: string;
}

const { caption, class: className = '' } = Astro.props;
---

<figure class={`w-full ${className}`}>
  <slot />
  {caption && (
    <figcaption class="mt-3 flex items-start gap-2 text-xs font-editorial-mono text-neutral-400 tracking-wide leading-relaxed">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-neutral-600 mt-1.5 shrink-0" aria-hidden="true"></span>
      <span>{caption}</span>
    </figcaption>
  )}
</figure>
