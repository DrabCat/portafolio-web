---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'INICIO', path: '/' },
  { name: 'PROYECTOS', path: '/proyectos' },
  { name: 'DESCARGAR CV', path: '/cv.pdf', external: true },
];
---

<header class="w-full py-7 px-6 md:px-12 lg:px-16 border-b border-neutral-900/80 bg-[#121212]/90 sticky top-0 z-50 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Logotipo Placeholder (Izquierda) -->
    <a href="/" class="group flex items-center gap-2 focus:outline-none">
      <div class="h-9 px-4 bg-neutral-100 text-neutral-950 font-editorial-mono font-bold tracking-tighter text-sm flex items-center justify-center rounded-sm transition-opacity group-hover:opacity-90">
        DANIELA F.J
      </div>
    </a>

    <!-- Menú Desktop (Centro) -->
    <nav class="hidden md:flex items-center gap-8 lg:gap-12 font-editorial-mono text-[11px] tracking-[0.18em] uppercase">
      {navItems.map(item => {
        const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
        return (
          <a
            href={item.path}
            target={item.external ? "_blank" : "_self"}
            rel={item.external ? "noopener noreferrer" : undefined}
            class={`relative py-1 transition-colors duration-200 ${
              isActive 
                ? 'text-white font-bold' 
                : 'text-neutral-400 hover:text-neutral-100'
            }`}
          >
            {item.name}
            {isActive && (
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-white rounded-full"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Botón Contáctame (Derecha) -->
    <div class="hidden md:block font-editorial-mono text-[11px] tracking-[0.18em] uppercase">
      <a 
        href="mailto:contacto@daniela.com" 
        class="text-neutral-400 hover:text-white py-1.5 px-3 rounded border border-transparent hover:border-neutral-800 transition-all duration-200"
      >
        CONTÁCTAME
      </a>
    </div>

    <!-- Toggle Menú Mobile -->
    <button 
      id="mobile-menu-toggle"
      aria-label="Abrir menú de navegación"
      class="md:hidden text-neutral-300 hover:text-white focus:outline-none p-2 font-editorial-mono text-xs tracking-widest border border-neutral-800 rounded"
    >
      MENU
    </button>
  </div>

  <!-- Menú desplegable Mobile -->
  <div id="mobile-menu" class="hidden md:hidden pt-6 pb-4 px-2 space-y-4 border-t border-neutral-800/60 mt-4 font-editorial-mono text-xs tracking-widest uppercase">
    {navItems.map(item => {
      const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
      return (
        <a
          href={item.path}
          target={item.external ? "_blank" : "_self"}
          class={`block py-2 ${isActive ? 'text-white font-bold pl-2 border-l-2 border-white' : 'text-neutral-400 hover:text-white'}`}
        >
          {item.name}
        </a>
      );
    })}
    <div class="pt-4 border-t border-neutral-900">
      <a 
        href="mailto:contacto@daniela.com" 
        class="block py-2 text-neutral-200 hover:text-white"
      >
        CONTÁCTAME
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    if (toggleBtn && mobileMenu) {
      // Re-bind click event cleanly
      toggleBtn.replaceWith(toggleBtn.cloneNode(true));
      const newToggleBtn = document.getElementById('mobile-menu-toggle');
      const currentMobileMenu = document.getElementById('mobile-menu');

      if (newToggleBtn && currentMobileMenu) {
        newToggleBtn.addEventListener('click', () => {
          currentMobileMenu.classList.toggle('hidden');
        });
      }
    }
  }

  document.addEventListener('DOMContentLoaded', setupMobileMenu);
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
