---
import ImageCaption from './ImageCaption.astro';

interface Props {
  videos?: string[];
  thumbnail?: string;
  projectName?: string;
  captions?: string[];
}

const { videos = [], thumbnail, projectName = 'Proyecto', captions = [] } = Astro.props;

const firstVideo = videos[0];
const remainingVideos = videos.slice(1);
const heroCaption = captions[0];
---

<section class="space-y-10 pt-4">
  <!-- Video principal con caption -->
  {firstVideo && (
    <ImageCaption caption={heroCaption} class="reveal-on-scroll">
      <div class="w-full aspect-[16/9] bg-[#181818] rounded-2xl overflow-hidden border border-neutral-800 shadow-2xl relative">
        <video
          src={firstVideo}
          autoplay
          muted
          loop
          playsinline
          class="w-full h-full object-cover object-center scale-[1.06]"
        >
          Tu navegador no soporta la reproducción de video.
        </video>
      </div>
    </ImageCaption>
  )}

  <!-- Galería de Videos con captions individuales -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
    {remainingVideos.map((videoUrl, idx) => {
      const caption = captions[idx + 1];
      return (
        <ImageCaption caption={caption} class="reveal-on-scroll">
          <div class="group relative w-full aspect-[16/10] bg-[#181818] rounded-2xl overflow-hidden border border-neutral-800/80 shadow-xl">
            {videoUrl.endsWith('.mp4') || videoUrl.endsWith('.webm') ? (
              <video
                src={videoUrl}
                autoplay
                muted
                loop
                playsinline
                class="w-full h-full object-cover object-center scale-[1.03]"
              >
                Tu navegador no soporta la reproducción de video.
              </video>
            ) : (
              <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-neutral-900/60 border border-dashed border-neutral-800">
                <div class="w-12 h-12 rounded-full border border-neutral-700 flex items-center justify-center mb-3 text-neutral-400 font-editorial-mono text-xs">
                  {idx + 1}
                </div>
                <span class="font-editorial-mono text-xs text-neutral-300 uppercase tracking-widest mb-1">
                  [VIDEO PLACEHOLDER {idx + 1}]
                </span>
                <span class="font-editorial-mono text-[10px] text-neutral-500">
                  Autoplay • Muted • Screen Recording
                </span>
              </div>
            )}
          </div>
        </ImageCaption>
      );
    })}
  </div>
</section>
