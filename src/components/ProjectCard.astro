---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a href={`/proyectos/${project.slug}`} class="group block space-y-4 cursor-pointer reveal-on-scroll">
  <!-- Escenario / Contenedor Exterior con Radius Discreto (rounded-2xl a rounded-lg) -->
  <div class="relative w-full aspect-[16/10] rounded-lg overflow-hidden bg-[#161616] border border-neutral-800/60 transition-all duration-500 ease-out group-hover:border-neutral-600 group-hover:shadow-2xl">
    
    <!-- Layer 1: Fondo Desenfocado Ampliado (Blur background visible con nitidez del sitio) -->
    <div 
      class="absolute inset-0 scale-125 filter blur-lg opacity-45 transition-all duration-500 ease-out group-hover:opacity-65 group-hover:scale-130 bg-cover bg-center"
      style={project.thumbnail ? `background-image: url('${project.thumbnail}')` : 'background-color: #1f1f1f'}
    ></div>

    <!-- Capa de oscurecimiento suave para dar contraste al video frontal -->
    <div class="absolute inset-0 bg-black/25 transition-opacity duration-500 group-hover:bg-black/15"></div>

    <!-- Layer 2: Ventana / Video Frontal con margen amplio y radius muy sutil (rounded-md/sm) -->
    <div class="absolute inset-8 sm:inset-10 md:inset-12 flex items-center justify-center overflow-hidden rounded-md bg-neutral-950 shadow-2xl border border-white/10 transition-transform duration-500 ease-out group-hover:scale-[1.03]">
      
      {project.previewVideo ? (
        <div class="relative w-full h-full">
          <img 
            src={project.thumbnail || '/assets/images/placeholder.svg'} 
            alt={project.name}
            class="w-full h-full object-cover object-top transition-opacity duration-500 ease-out group-hover:opacity-0"
          />
          <video 
            src={project.previewVideo}
            muted
            loop
            playsinline
            preload="metadata"
            class="absolute inset-0 w-full h-full object-cover object-center scale-[1.03] opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100"
            onmouseenter="this.play()"
            onmouseleave="this.pause(); this.currentTime = 0;"
          ></video>
        </div>
      ) : project.thumbnail ? (
        <img 
          src={project.thumbnail} 
          alt={project.name}
          class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.02]"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center text-neutral-500 font-editorial-mono text-xs p-4 text-center bg-neutral-900/90">
          <span class="mb-2 text-neutral-400">[PLACEHOLDER VIDEO/SITIO]</span>
          <span>{project.name}</span>
        </div>
      )}

      <!-- Indicator Overlay discreto -->
      <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none flex items-end justify-end p-3">
        <span class="font-editorial-mono text-[9px] tracking-widest text-white/90 bg-black/70 backdrop-blur-md px-2.5 py-1 rounded-sm border border-white/10 uppercase">
          Ver Proyecto ↗
        </span>
      </div>
    </div>
  </div>

  <!-- Nombre del proyecto -->
  <h3 class="font-editorial-mono text-xs font-bold tracking-[0.16em] uppercase text-neutral-300 group-hover:text-white transition-colors duration-200 pl-0.5">
    {project.name}
  </h3>
</a>
